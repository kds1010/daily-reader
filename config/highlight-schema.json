{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "headline": { "type": "string" },
    "overview": { "type": "string" },
    "field_highlights": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string",
            "enum": ["データ・AI", "データマネジメント・エンジニアリング書籍", "生成AI活用・テクニック", "CLI・ターミナル生産性", "業務改善・QOL", "子育て", "横浜イベント", "街の新店", "睡眠", "筋トレ"]
          },
          "summary": { "type": "string" },
          "items": {
            "type": "array",
            "minItems": 0,
            "maxItems": 5,
            "items": {
              "type": "object",
              "properties": {
                "article_id": { "type": "string" },
                "label": { "type": "string" },
                "reason": { "type": "string" }
              },
              "required": ["article_id", "label", "reason"],
              "additionalProperties": false
            }
          }
        },
        "required": ["field", "summary", "items"],
        "additionalProperties": false
      }
    },
    "official_digest": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "properties": {
          "product": { "type": "string" },
          "summary": { "type": "string" },
          "changes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": { "type": "string" }
          },
          "article_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": { "type": "string" }
          }
        },
        "required": ["product", "summary", "changes", "article_ids"],
        "additionalProperties": false
      }
    },
    "gadget_digest": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "properties": {
          "theme": { "type": "string" },
          "summary": { "type": "string" },
          "benefits": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": { "type": "string" }
          },
          "article_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": { "type": "string" }
          }
        },
        "required": ["theme", "summary", "benefits", "article_ids"],
        "additionalProperties": false
      }
    },
    "tech_picks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "properties": {
          "article_id": { "type": "string" },
          "label": { "type": "string" },
          "insight": { "type": "string" },
          "why_read": { "type": "string" }
        },
        "required": ["article_id", "label", "insight", "why_read"],
        "additionalProperties": false
      }
    }
  },
  "required": ["headline", "overview", "field_highlights", "official_digest", "gadget_digest", "tech_picks"],
  "additionalProperties": false
}
