<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
    <key>NSCalendarsFullAccessUsageDescription</key>
    <string>予定の追加・変更と重複確認にカレンダーを使います。iPhoneでは件名・日時・場所を自分のMacへ同期し、空き時間や会話の状況を確認します。</string>
    <key>NSMotionUsageDescription</key>
    <string>会話時に歩行中・移動中だったかを振り返るため、移動状態と時刻を自分のMacへ同期します。</string>
    <key>CFBundleDisplayName</key><string>Daymeld</string>
    <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
    <key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key><string>MP3 Audio</string>
            <key>CFBundleTypeRole</key><string>Viewer</string>
            <key>LSHandlerRank</key><string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array><string>public.mp3</string></array>
        </dict>
    </array>
    <key>LSSupportsOpeningDocumentsInPlace</key><false/>
    <key>LSRequiresIPhoneOS</key><true/>
    <key>NSHealthShareUsageDescription</key><string>睡眠、歩数、心拍などをDaymeldの体調画面へ同期します。</string>
    <key>NSHealthUpdateUsageDescription</key><string>DaymeldはHealthKitへの書き込みを行いません。</string>
    <key>NSLocationWhenInUseUsageDescription</key><string>取得した位置・時刻・精度を端末に保存し、Mac miniへ同期して履歴と地図に表示します。記録開始後はバックグラウンドでも移動を記録します。</string>
    <key>UIApplicationSceneManifest</key><dict><key>UIApplicationSupportsMultipleScenes</key><false/></dict>
    <key>UIBackgroundModes</key><array><string>fetch</string><string>location</string></array>
    <key>BGTaskSchedulerPermittedIdentifiers</key><array><string>net.skmin.DailyReader.agent-refresh</string></array>
    <key>UILaunchScreen</key><dict><key>UIColorName</key><string></string></dict>
    <key>UISupportedInterfaceOrientations</key><array><string>UIInterfaceOrientationPortrait</string></array>
</dict></plist>
